# Copy to .env and fill in. .env is git-ignored; never commit real keys.
# On your host (Vercel, Netlify, etc.) add the same variables in the project settings.

# Live Instagram feed for the @bommienoosa grid (optional).
# Create a free JSON feed at https://behold.so and connect @bommienoosa
# (Instagram must be a Business or Creator account).
VITE_INSTAGRAM_FEED_URL=

# Stripe Payment Links, one per colour + size (Stripe dashboard > Payment Links).
# These are public checkout URLs and are safe to ship to the browser.
STRIPE_PAYMENT_LINK_OCEANBLUE_KIDS=
STRIPE_PAYMENT_LINK_OCEANBLUE_SM=
STRIPE_PAYMENT_LINK_OCEANBLUE_XL=
STRIPE_PAYMENT_LINK_MIDNIGHT_KIDS=
STRIPE_PAYMENT_LINK_MIDNIGHT_SM=
STRIPE_PAYMENT_LINK_MIDNIGHT_XL=
STRIPE_PAYMENT_LINK_CRIMSON_KIDS=
STRIPE_PAYMENT_LINK_CRIMSON_SM=
STRIPE_PAYMENT_LINK_CRIMSON_XL=

# Stripe API keys are NOT used by this site (Payment Links need no keys).
# If you keep them here for other tools, they stay out of the site bundle,
# but never commit them.
